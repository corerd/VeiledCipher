# Ignore Python cache directories
**/__pycache__

# Ignore common image file types
# (png, jpg, jpeg, gif, svg, bmp, tiff, webp, ico, etc.)

# Image files
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tif
*.tiff
*.webp
*.svg
*.ico
*.heic
*.avif

# Ignore images directories and all content inside them
/images/
/assets/images/
**/images/

# OS and editor junk
.DS_Store
Thumbs.db

# Keep README or gitkeep if you want an empty images folder tracked
!images/.gitkeep
