{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Asset Packer GUI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/asset_packer_gui.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Asset Packer CLI (pack example)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/asset_packer_cli.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "encode",
        "-c", "${workspaceFolder}/test/carrier.jpg",
        "-f", "${workspaceFolder}/test/asset.txt",
        "-p", "NotProductionBuildPassword",
        "-o", "${workspaceFolder}/test/output/packed.png"
      ],
    },
    {
      "name": "Debug Asset Packer CLI (unpack example)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/asset_packer_cli.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "decode",
        "-s", "${workspaceFolder}/test/output/packed.png",
        "-p", "NotProductionBuildPassword",
        "-d", "${workspaceFolder}/test/output/asset_recovered.txt"
      ],
    }
  ]
}